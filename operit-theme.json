          "*": "赛博字体缩放",
          "en": "Cyber typography scale"
        }
      },
      "description": {
        "values": {
          "*": "调整赛博界面文字的整体比例",
          "en": "Adjusts the overall scale of Cyber Grid text"
        }
      },
      "control": {
        "type": "slider",
        "minimum": 0.85,
        "maximum": 1.2,
        "step": 0.05
      },
      "effects": [
        {
          "type": "typography_scale"
        }
      ],
      "visibility": "USER",
      "section": "APPEARANCE",
      "order": 4,
      "visibleWhen": []
    },
    {
