            "cyber.magenta"
          ]
        }
      ],
      "visibility": "USER",
      "section": "APPEARANCE",
      "order": 1,
      "visibleWhen": []
    },
    {
      "id": "cyber_background_image",
      "type": "IMAGE_URI",
      "label": {
        "values": {
          "*": "自定义背景图片",
          "en": "Custom background image"
        }
      },
      "description": {
        "values": {
          "*": "显示在赛博应用与聊天场景底层",
          "en": "Shown behind the Cyber Grid app and chat scenes"
        }
      },
      "control": {
        "type": "image_picker",
        "mimeTypes": [
          "image/jpeg",
          "image/png",
          "image/webp"
        ]
      },
      "effects": [
        {
          "type": "stage_image",
          "surfaceIds": [
            "app.shell",
            "chat.main"
          ],
          "fit": "CROP",
          "opacity": 0.22
        }
      ],
      "visibility": "USER",
      "section": "APPEARANCE",
      "order": 2,
      "visibleWhen": []
    },
    {
      "id": "cyber_background_opacity",
      "type": "FLOAT",
      "defaultValue": {
        "type": "float",
        "value": 0.22
      },
      "label": {
        "values": {
          "*": "自定义背景不透明度",
          "en": "Custom background opacity"
        }
      },
      "description": {
        "values": {
          "*": "调整自定义背景图片的显示强度",
          "en": "Adjusts the visibility of the custom background image"
        }
      },
      "control": {
        "type": "slider",
        "minimum": 0.0,
        "maximum": 1.0,
        "step": 0.05
      },
      "effects": [
        {
          "type": "presentation",
          "targets": [
            "BACKGROUND_OPACITY"
          ]
        }
      ],
      "visibility": "USER",
      "section": "APPEARANCE",
      "order": 3,
      "visibleWhen": [
        {
          "type": "resource_present",
          "parameterId": "cyber_background_image"
        }
      ]
    },
    {
