      "visibility": "AUTHOR",
      "order": 2,
      "visibleWhen": []
    },
    {
      "id": "cyber_show_avatars",
      "type": "BOOLEAN",
      "defaultValue": {
        "type": "boolean",
        "value": true
      },
      "label": {
        "values": {
          "*": "显示头像",
          "en": "Show avatars"
        }
      },
      "description": {
        "values": {
          "*": "在对话消息旁显示参与者头像",
          "en": "Shows participant avatars beside conversation messages"
        }
      },
      "control": {
        "type": "toggle"
      },
      "effects": [
        {
          "type": "presentation",
          "targets": [
            "BUBBLE_SHOW_AVATAR"
