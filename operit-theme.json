        }
      ],
      "visibility": "USER",
      "section": "CONVERSATION",
      "order": 0,
      "visibleWhen": []
    },
    {
      "id": "cyber_wide_bubbles",
      "type": "BOOLEAN",
      "defaultValue": {
        "type": "boolean",
        "value": false
      },
      "label": {
        "values": {
          "*": "加宽消息气泡",
          "en": "Wide message bubbles"
        }
      },
      "description": {
        "values": {
          "*": "让消息气泡占用更多对话宽度",
          "en": "Lets message bubbles use more conversation width"
        }
      },
      "control": {
        "type": "toggle"
      },
      "effects": [
        {
          "type": "presentation",
          "targets": [
            "BUBBLE_WIDE_LAYOUT"
          ]
        }
      ],
      "visibility": "USER",
      "section": "CONVERSATION",
      "order": 1,
      "visibleWhen": []
    },
    {
      "id": "cyber_avatar_shape",
