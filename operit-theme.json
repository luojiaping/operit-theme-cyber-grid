                "en": "Square"
              }
            }
          },
          {
            "id": "rounded",
            "label": {
              "values": {
                "*": "圆角方形",
                "en": "Rounded"
              }
            }
          }
        ]
      },
      "effects": [
        {
          "type": "presentation",
          "targets": [
            "AVATAR_SHAPE"
          ]
        }
      ],
      "visibility": "USER",
      "section": "CONVERSATION",
      "order": 2,
      "visibleWhen": [
        {
          "type": "boolean_equals",
          "parameterId": "cyber_show_avatars",
