{
  "schemaVersion": 4,
  "packageId": "operit.cyber_grid",
  "version": "3.0.0",
  "displayName": {
    "values": {
      "*": "赛博网格",
      "en": "Cyber Grid"
    }
  },
  "author": {
    "values": {
      "*": "Operit Reference Themes"
    }
  },
  "description": {
    "values": {
      "*": "Hubble 星云背景、青蓝霓虹框与洋红信号线构成的赛博壳层，覆盖应用全部日常界面。",
      "en": "A cyber shell with a Hubble nebula backdrop, cyan neon frames, and magenta signal lines across all daily surfaces."
    }
  },
  "attribution": {
    "text": {
      "values": {
        "*": "Background image: The Ring Nebula (M57), The Hubble Heritage Team (AURA/STScI/NASA)."
      }
    },
    "sourceUrl": "https://science.nasa.gov/asset/hubble/the-ring-nebula-m57/"
  },
  "basis": {
    "packageId": "operit.default",
    "version": "3.0.0",
    "archiveSha256": "5a96abf521ec22a8c486ccb5b4d7f561a4bed4f6f90dfe742647024eb79db91f"
  },
  "parameters": [
    {
      "id": "cyber_cyan_color",
      "type": "COLOR",
      "defaultValue": {
        "type": "color",
        "argb": 4278237396
      },
      "label": {
        "values": {
          "*": "青色霓虹",
          "en": "Cyan neon"
        }
      },
      "description": {
        "values": {
          "*": "调整赛博网格框架使用的青色信号",
          "en": "Adjusts the cyan signal used by Cyber Grid frames"
        }
      },
      "control": {
        "type": "color_palette",
        "presetArgb": [
          4278237396,
          4278248959
